{
  "manifest_version": 3,
  "name": "Scribble Deals",
  "version": "0.1.0",
  "description": "Finds you deals while you use AI search. Reads the page on your device only. Nothing you type ever leaves your computer.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Scribble Deals"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content/taxonomy.js",
        "content/classifier.js",
        "content/config.js",
        "content/adapters/chatgpt.js",
        "content/adapters/claude.js",
        "content/adapters/google.js",
        "content/adapters/perplexity.js",
        "content/adapters/gemini.js",
        "content/adapters/index.js",
        "content/panel.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content/taxonomy.js",
        "content/classifier.js",
        "content/config.js",
        "content/adapters/chatgpt.js",
        "content/adapters/claude.js",
        "content/adapters/google.js",
        "content/adapters/perplexity.js",
        "content/adapters/gemini.js",
        "content/adapters/index.js",
        "content/panel.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/search*"
      ],
      "js": [
        "content/taxonomy.js",
        "content/classifier.js",
        "content/config.js",
        "content/adapters/chatgpt.js",
        "content/adapters/claude.js",
        "content/adapters/google.js",
        "content/adapters/perplexity.js",
        "content/adapters/gemini.js",
        "content/adapters/index.js",
        "content/panel.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "content/taxonomy.js",
        "content/classifier.js",
        "content/config.js",
        "content/adapters/chatgpt.js",
        "content/adapters/claude.js",
        "content/adapters/google.js",
        "content/adapters/perplexity.js",
        "content/adapters/gemini.js",
        "content/adapters/index.js",
        "content/panel.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content/taxonomy.js",
        "content/classifier.js",
        "content/config.js",
        "content/adapters/chatgpt.js",
        "content/adapters/claude.js",
        "content/adapters/google.js",
        "content/adapters/perplexity.js",
        "content/adapters/gemini.js",
        "content/adapters/index.js",
        "content/panel.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/offers.json"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://www.google.com/*",
        "https://www.perplexity.ai/*",
        "https://gemini.google.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
